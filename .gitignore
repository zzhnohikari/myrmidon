# Dependencies: none (Python 3 stdlib). The pyc cache must never ship.
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Rendered graph snapshots / local artifacts (generated, not source)
*.html
!lib/view_template.html
fact-graph.html

# Per-project fact-graph data — belongs in the *using* project, not here.
# (this only matters if someone runs `fgc` inside this repo)
.fg/
.fg-claude/

# Stray session logs / scratch
agents/
*.log
.DS_Store
.idea/
.vscode/

# image tarballs are build artifacts — shipped separately, never in git
dist/*.tar.gz

# private docs — never public
HANDOVER.md
PREP-INTERVIEW.md
docker/ENV-COMMANDER.md
COMMANDER-HANDOVER.md

# Myrmidon 交付物：手册 HTML 需要入库（上面的 *.html 规则是给本地快照用的）
!docs/使用手册.html
